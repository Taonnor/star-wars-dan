<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Deterministische Quellen: dieses Repo wird als Workshop-Beispiel geklont und muss
         ohne maschinenlokale Konfiguration wiederherstellbar sein. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Die TProg.Framework-Pakete liegen im Ordner nuget/ dieses Repos. Der relative Pfad
         wird gegen den Ort dieser Datei aufgelöst, gilt also in jedem Klon. -->
    <add key="TProg Framework (mitgeliefert)" value="nuget" />
  </packageSources>
</configuration>
