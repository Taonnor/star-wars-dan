<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Deterministic sources: this repository is cloned as a workshop example and must
         restore without any machine-local configuration. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The TProg.Framework packages live in the nuget/ folder of this repository. The relative
         path is resolved against the location of this file, so it holds in every clone. -->
    <add key="TProg Framework (mitgeliefert)" value="nuget" />
  </packageSources>
</configuration>
