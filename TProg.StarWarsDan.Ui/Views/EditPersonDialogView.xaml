<UserControl x:Class="TProg.StarWarsDan.Ui.Views.EditPersonDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:TProg.StarWarsDan.Domain;assembly=TProg.StarWarsDan.Domain"
             xmlns:local="clr-namespace:TProg.StarWarsDan.Ui.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:viewModels="clr-namespace:TProg.StarWarsDan.Ui.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:EditPersonDialogViewModel,
                                              IsDesignTimeCreatable=False}"
             Language="de-DE"
             mc:Ignorable="d">
    <UserControl.Resources>
        <d:ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/TProg.Framework.Style;component/Assets/Colors.xaml" />
        </d:ResourceDictionary.MergedDictionaries>

        <ObjectDataProvider x:Key="GenderEnumValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:Gender" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!--  The user reads German names; the values of the enum stay as they are  -->
        <DataTemplate x:Key="GenderTemplate" DataType="{x:Type domain:Gender}">
            <TextBlock x:Name="GenderText"
                       Foreground="{StaticResource TProg.Colors.NormalBackground}"
                       Text="{Binding}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:Gender.Female}">
                    <Setter TargetName="GenderText" Property="Text" Value="weiblich" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:Gender.Male}">
                    <Setter TargetName="GenderText" Property="Text" Value="männlich" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,16,0"
                    Orientation="Vertical">
            <TextBlock Height="24" Text="Name" />
            <TextBlock Height="24" Text="Größe" />
            <TextBlock Height="24" Text="Gewicht" />
            <TextBlock Height="24" Text="Geburtsjahr" />
            <TextBlock Height="24" Text="Geschlecht" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Height="24" Text="{Binding EditedPerson.Name}" />
            <TextBox Height="24" Text="{Binding PersonHeight}" />
            <TextBlock Height="24" Text="{Binding EditedPerson.Mass}" />
            <TextBox Height="24" Text="{Binding BirthYear}" />
            <ComboBox Height="24"
                      ItemTemplate="{StaticResource GenderTemplate}"
                      ItemsSource="{Binding Source={StaticResource GenderEnumValues}}"
                      SelectedItem="{Binding Gender}" />
        </StackPanel>

    </Grid>
</UserControl>
