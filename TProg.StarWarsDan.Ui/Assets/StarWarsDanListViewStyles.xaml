<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TProg.Framework.Style;component/Assets/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Color definitions  -->
    <SolidColorBrush x:Key="TProg.Colors.HoverBrackground" Color="{StaticResource TProgGray2}" />
    <SolidColorBrush x:Key="TProg.Colors.SelectedBackground" Color="{StaticResource TProgGray1}" />

    <Style x:Key="StarWarsListViewItemContainerStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="BorderBrush" Value="{StaticResource TProg.Colors.NormalControlBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TProg.Colors.HoverBrackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource TProg.Colors.SelectedBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StarWarsListView" TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{StaticResource TProg.Colors.NormalControlBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TProg.Colors.NormalForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource TProg.Colors.NormalControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource StarWarsListViewItemContainerStyle}" />
    </Style>
</ResourceDictionary>