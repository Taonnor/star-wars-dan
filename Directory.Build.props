<Project>

  <PropertyGroup>
    <!--
      The single place where the .NET version of this repository is defined. Every project derives
      its TargetFramework from it and appends its platform suffix where it has one. The name is the
      same as in tprog-framework; which version it holds follows the workspace rule.
      The CI workflow's `dotnet-version`, the SDK in global.json and the runtime named in README.md
      follow it.
    -->
    <TProgDotNetVersion>net10.0</TProgDotNetVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Makes the IDE rules of .editorconfig part of the build, so that they fail it as well. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Checks the code rules of the TProg Framework in every project of this repository, also those
      without a reference to the framework (AD-28 of tprog-framework). A build-time tool only.
    -->
    <PackageReference Include="TProg.Framework.Analyzers" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
